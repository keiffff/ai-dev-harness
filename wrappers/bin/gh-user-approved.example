#!/bin/zsh
set -euo pipefail

if [[ "${1:-}" != "--confirm-user-requested" ]]; then
  print -u2 "PR/issue operations require an explicit latest user request and --confirm-user-requested."
  exit 2
fi
shift

if [[ ("${1:-}" != "pr" && "${1:-}" != "issue" && "${1:-}" != "api") || $# -lt 2 ]]; then
  print -u2 "Usage: gh-user-approved --confirm-user-requested pr|issue|api <command-or-endpoint> [args...]"
  exit 2
fi

# API supports requested PR/issue operations missing from the CLI command families.
# Do not maintain per-endpoint, subcommand or field allowlists here.
# Codex owns matching the requested operation and target to the latest user request.
# Opt-in CI routing records the chat that actually created this PR. Failure to
# register must not hide a successful GitHub write or repeat PR creation.
ci_events_script="${CODEX_CI_EVENTS_SCRIPT:-$HOME/.codex/ci-events/bridge.py}"
if [[ "${1:-}" == "pr" && "${2:-}" == "create" && -f "$ci_events_script" && -n "${CODEX_THREAD_ID:-}" ]]; then
  pr_output=$(gh "$@")
  print -r -- "$pr_output"
  pr_url=$(print -r -- "$pr_output" | /usr/bin/python3 -c 'import re,sys; matches=re.findall(r"https://github.com/[\w.-]+/[\w.-]+/pull/\d+",sys.stdin.read()); print(matches[-1] if matches else "")')
  if [[ -n "$pr_url" ]]; then
    if ! /usr/bin/python3 "$ci_events_script" bind --pr-url "$pr_url" --thread "$CODEX_THREAD_ID" --cwd "$PWD" >&2; then
      print -u2 "PR was created, but CI chat routing was not registered. Bind this existing PR; do not create it again."
    fi
  fi
  exit 0
fi
exec gh "$@"
