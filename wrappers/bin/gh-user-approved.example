#!/bin/zsh
set -euo pipefail

if [[ "${1:-}" != "--confirm-user-requested" ]]; then
  print -u2 "PR/issue operations require an explicit latest user request and --confirm-user-requested."
  exit 2
fi
shift

if [[ ("${1:-}" != "pr" && "${1:-}" != "issue" && "${1:-}" != "api") || $# -lt 2 ]]; then
  print -u2 "Usage: gh-user-approved --confirm-user-requested pr|issue|api <command-or-endpoint> [args...]"
  exit 2
fi

# API supports requested PR/issue operations missing from the CLI command families.
# Do not maintain per-endpoint, subcommand or field allowlists here.
# Codex owns matching the requested operation and target to the latest user request.
exec gh "$@"
