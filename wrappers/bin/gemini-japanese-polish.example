#!/usr/bin/env python3

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path


MODEL = "gemini-3.8-flash-medium"
DEFAULT_ANTIGRAVITY_CLI = "/Users/kei/.local/bin/agy"
DEFAULT_TIMEOUT_SECONDS = 600
MAX_INPUT_CHARS = 100_000
MAX_DIAGNOSTIC_CHARS = 8_000
HTML_COMPLETION_MARKER = "<!-- GEMINI_COMPLETE_HTML -->"


def stop(message: str, exit_code: int = 2) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(exit_code)


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Polish one Japanese draft with Gemini 3.8 Flash."
    )
    parser.add_argument("--input-file", required=True)
    parser.add_argument("--output-file", required=True)
    parser.add_argument(
        "--medium",
        choices=("general", "github", "slack", "ui-copy", "release-note", "html"),
        default="general",
    )
    return parser.parse_args(argv)


def resolve_input_file(raw: str) -> Path:
    input_file = Path(raw).expanduser()
    if not input_file.is_file():
        stop("--input-file requires an existing regular file.")
    return input_file.resolve()


def resolve_output_file(raw: str) -> Path:
    output_file = Path(raw).expanduser()
    if output_file.exists() or output_file.is_symlink():
        stop("--output-file must not already exist.")
    parent = output_file.parent.resolve()
    if not parent.is_dir():
        stop("--output-file parent directory must already exist.")
    return parent / output_file.name


def load_api_key() -> str:
    configured = os.environ.get("GEMINI_API_KEY", "").strip()
    if configured:
        return configured

    account = os.environ.get("USER", "")
    if not account:
        stop("USER is required for macOS Keychain lookup.", 1)
    result = subprocess.run(
        [
            "/usr/bin/security",
            "find-generic-password",
            "-a",
            account,
            "-s",
            "GEMINI_JAPANESE_POLISH_API_KEY",
            "-w",
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    api_key = result.stdout.strip()
    if result.returncode != 0 or not api_key:
        stop("GEMINI_JAPANESE_POLISH_API_KEY was not found in macOS Keychain.", 1)
    return api_key


def timeout_seconds() -> int:
    raw = os.environ.get(
        "GEMINI_JAPANESE_POLISH_TIMEOUT_SECONDS",
        str(DEFAULT_TIMEOUT_SECONDS),
    )
    try:
        value = int(raw)
    except ValueError:
        stop("GEMINI_JAPANESE_POLISH_TIMEOUT_SECONDS must be an integer.")
    if not 1 <= value <= 900:
        stop("GEMINI_JAPANESE_POLISH_TIMEOUT_SECONDS must be between 1 and 900.")
    return value


def antigravity_cli() -> Path:
    value = os.environ.get(
        "GEMINI_JAPANESE_POLISH_ANTIGRAVITY_CLI",
        DEFAULT_ANTIGRAVITY_CLI,
    )
    candidate = Path(value).expanduser()
    if not candidate.is_absolute() or not candidate.is_file() or not os.access(candidate, os.X_OK):
        stop("Antigravity CLI must be an existing absolute executable path.", 1)
    return candidate.resolve()


def fixed_contract(medium: str, html_recovery: bool = False) -> str:
    contract = f"""You are the principal Japanese writer for one bounded composition pass.
The input may be a writing brief, verified fact list, source material, a rough draft, or a combination of them.
When the input uses writing-packet tags, treat `<writing-brief>` as instructions, `<required-content>` as facts that must be represented, `<reference-draft>` as optional source prose, and each `<verbatim>` block as text that must remain exact. Do not reproduce the tags.
Produce the complete final Japanese deliverable for the requested medium: {medium}.
Take ownership of the overall structure, headings, paragraph order, transitions, tone, concision, and wording. You may reorganize, merge, split, or comprehensively rewrite the source when that improves the deliverable.
Preserve every required fact, scope boundary, uncertainty, and level of certainty. Do not invent causes, evaluations, owners, dates, promises, procedures, or verification claims.
Keep proper nouns, product names, numbers, dates, URLs, citations, code, commands, and file paths factually exact. Preserve any span explicitly marked as verbatim.
Do not use tools, inspect files, browse, run commands, or delegate work. Work only from the text in this prompt.
Do not describe the writing brief or your process. Return the complete deliverable as revised_text. Record concise notes about material compositional choices and any unresolved ambiguity in the structured fields.
"""
    if medium == "html":
        contract += f"""
The revised_text must be one complete standalone HTML document, beginning with <!doctype html> and ending with </html> followed by {HTML_COMPLETION_MARKER}.
Never return an excerpt, outline, partial document, or explanation. Include every closing tag and the completion marker even when the source is long.
"""
    if html_recovery:
        contract += """
The previous generation ended before the required completion marker. Regenerate the entire document from the beginning; do not continue the previous fragment.
"""
    return contract


def response_schema() -> dict:
    return {
        "type": "object",
        "properties": {
            "revised_text": {
                "type": "string",
                "description": "The complete polished draft.",
            },
            "changes": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Concise descriptions of material wording changes.",
            },
            "warnings": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Ambiguities or edits deliberately not made.",
            },
        },
        "required": ["revised_text", "changes", "warnings"],
    }


def composition_prompt(source: str, medium: str, html_recovery: bool = False) -> str:
    return f"{fixed_contract(medium, html_recovery)}\n<source>\n{source}\n</source>"


def diagnostic_excerpt(value: str, api_key: str) -> str:
    cleaned = (value or "").replace(api_key, "[REDACTED]")
    cleaned = re.sub(r"(?i)(x-goog-api-key\s*[:=]\s*)\S+", r"\1[REDACTED]", cleaned)
    cleaned = "".join(
        character for character in cleaned
        if character in "\n\r\t" or character.isprintable()
    ).strip()
    if len(cleaned) <= MAX_DIAGNOSTIC_CHARS:
        return cleaned
    return "[truncated]\n" + cleaned[-MAX_DIAGNOSTIC_CHARS:]


def call_gemini(prompt: str, api_key: str, timeout: int) -> dict:
    stream_input = json.dumps(
        {"event": "user", "message": {"content": prompt}},
        ensure_ascii=False,
    ) + "\n"
    settings = {
        "modelProvider": "gemini",
        "toolPermission": "strict",
        "artifactReviewPolicy": "always-proceed",
        "enableTerminalSandbox": True,
        "verbosity": "low",
        "showTips": False,
        "enableTelemetry": False,
    }
    command = [
        str(antigravity_cli()),
        "--model", MODEL,
        "--output-format", "stream-json",
        "--input-format", "stream-json",
        "--json-schema", json.dumps(response_schema(), ensure_ascii=False, separators=(",", ":")),
        "--print-timeout", f"{timeout}s",
        "--sandbox",
        "--disable-slash-commands",
    ]

    with tempfile.TemporaryDirectory(prefix="gemini-japanese-polish-") as temporary_home:
        settings_dir = Path(temporary_home) / ".gemini" / "antigravity-cli"
        settings_dir.mkdir(parents=True)
        (settings_dir / "settings.json").write_text(
            json.dumps(settings, ensure_ascii=False) + "\n",
            encoding="utf-8",
        )
        child_env = os.environ.copy()
        child_env["HOME"] = temporary_home
        child_env["GEMINI_API_KEY"] = api_key
        try:
            completed = subprocess.run(
                command,
                input=stream_input,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                cwd=temporary_home,
                env=child_env,
                timeout=timeout + 15,
                check=False,
            )
        except subprocess.TimeoutExpired:
            stop(f"Antigravity CLI timed out after {timeout} seconds.", 124)

    result = None
    for line in completed.stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(event, dict) and event.get("event") == "result":
            result = event.get("result")
    if not isinstance(result, dict):
        excerpt = diagnostic_excerpt(completed.stderr, api_key)
        if excerpt:
            print(f"Antigravity CLI response:\n{excerpt}", file=sys.stderr)
        stop("Antigravity CLI did not return a result event.", 1)
    if completed.returncode != 0 or result.get("status") != "SUCCESS":
        detail = "\n".join(
            value for value in (str(result.get("error", "")), completed.stderr) if value
        )
        excerpt = diagnostic_excerpt(detail, api_key)
        if excerpt:
            print(f"Antigravity CLI response:\n{excerpt}", file=sys.stderr)
        stop(
            f"Antigravity CLI composition failed (status={result.get('status', 'missing')}).",
            1,
        )
    return result


def extract_structured_output(response: dict) -> dict:
    output = response.get("structured_output")
    if output is None and isinstance(response.get("response"), str):
        try:
            output = json.loads(response["response"])
        except json.JSONDecodeError:
            pass
    if not isinstance(output, dict) or set(output) != {"revised_text", "changes", "warnings"}:
        stop("Antigravity CLI structured output had an unexpected shape.", 1)
    if not isinstance(output["revised_text"], str) or not output["revised_text"].strip():
        stop("Antigravity CLI structured output did not contain revised text.", 1)
    if not all(isinstance(output[name], list) and all(isinstance(item, str) for item in output[name]) for name in ("changes", "warnings")):
        stop("Antigravity CLI structured output contained invalid notes.", 1)
    return output


PROTECTED_PATTERNS = {
    "fenced code": re.compile(r"```[\s\S]*?```"),
    "inline code": re.compile(r"(?<!`)`[^`\n]+`(?!`)"),
    "URL": re.compile(r"https?://[A-Za-z0-9._~:/?#\[\]@!$&'()*+,;=%-]+"),
    "number": re.compile(r"(?<![\w])\d[\d,./:%+-]*(?![\w])"),
    "citation": re.compile(r"\[\^?[^\]\n]+\]"),
    "absolute path": re.compile(
        r"(?<![:/\w])/(?!/)[A-Za-z0-9._~+@%=-]+(?:/[A-Za-z0-9._~+@%=-]+)*"
    ),
}


def protected_content(source: str) -> tuple[str, list[str]]:
    required_blocks = re.findall(
        r"<required-content>([\s\S]*?)</required-content>",
        source,
        flags=re.IGNORECASE,
    )
    verbatim_blocks = [
        value.strip()
        for value in re.findall(
            r"<verbatim>([\s\S]*?)</verbatim>",
            source,
            flags=re.IGNORECASE,
        )
        if value.strip()
    ]
    if required_blocks or verbatim_blocks:
        return "\n".join(required_blocks + verbatim_blocks), verbatim_blocks
    return source, []


def protected_matches(label: str, pattern: re.Pattern[str], value: str) -> set[str]:
    if label == "number":
        value = re.sub(r"(?m)^\s*\d+[.)]\s+", "", value)
    return set(pattern.findall(value))


def preserved_span_warnings(source: str, revised: str) -> list[str]:
    warnings = []
    protected, verbatim_blocks = protected_content(source)
    for label, pattern in PROTECTED_PATTERNS.items():
        before = protected_matches(label, pattern, protected)
        after = protected_matches(label, pattern, revised)
        if before != after:
            warnings.append(
                f"Gemini output changed protected {label}; Codex must verify or restore it."
            )
    for block in verbatim_blocks:
        if block not in revised:
            warnings.append(
                "Gemini output changed an explicitly verbatim span; Codex must restore it."
            )
    return warnings


def complete_html(value: str) -> str | None:
    candidate = value.rstrip()
    if not candidate.endswith(HTML_COMPLETION_MARKER):
        return None
    candidate = candidate[: -len(HTML_COMPLETION_MARKER)].rstrip()
    if not re.fullmatch(
        r"(?is)\s*<!doctype\s+html[^>]*>.*</html>\s*",
        candidate,
    ):
        return None
    return candidate


def emit_usage(response: dict) -> None:
    usage = response.get("usage")
    if not isinstance(usage, dict):
        return
    safe_usage = {
        key: usage[key]
        for key in (
            "input_tokens",
            "output_tokens",
            "thinking_tokens",
            "cache_read_tokens",
            "total_tokens",
        )
        if isinstance(usage.get(key), int)
    }
    if safe_usage:
        print(json.dumps({"model": MODEL, "usage": safe_usage}, ensure_ascii=False), file=sys.stderr)


def main() -> None:
    args = parse_args(sys.argv[1:])
    input_file = resolve_input_file(args.input_file)
    output_file = resolve_output_file(args.output_file)
    try:
        source = input_file.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        stop("--input-file must be UTF-8.")
    if not source.strip():
        stop("--input-file must not be empty.")
    if len(source) > MAX_INPUT_CHARS:
        stop(f"--input-file must not exceed {MAX_INPUT_CHARS} characters.")

    api_key = load_api_key()
    timeout = timeout_seconds()
    response = call_gemini(composition_prompt(source, args.medium), api_key, timeout)
    output = extract_structured_output(response)
    revised_text = output["revised_text"]
    if args.medium == "html":
        verified_html = complete_html(revised_text)
        if verified_html is None:
            print(
                "Gemini returned incomplete HTML; regenerating the complete document once.",
                file=sys.stderr,
            )
            response = call_gemini(
                composition_prompt(source, args.medium, html_recovery=True),
                api_key,
                timeout,
            )
            output = extract_structured_output(response)
            verified_html = complete_html(output["revised_text"])
            if verified_html is None:
                stop("Gemini returned incomplete HTML twice; no output was written.", 1)
        revised_text = verified_html
    local_warnings = preserved_span_warnings(source, revised_text)
    try:
        with output_file.open("x", encoding="utf-8") as stream:
            stream.write(revised_text.rstrip() + "\n")
    except FileExistsError:
        stop("--output-file must not already exist.")
    emit_usage(response)
    combined_warnings = output["warnings"] + local_warnings
    if output["changes"] or combined_warnings:
        print(json.dumps({
            "changes": output["changes"],
            "warnings": combined_warnings,
        }, ensure_ascii=False), file=sys.stderr)
    print(output_file)


if __name__ == "__main__":
    main()
