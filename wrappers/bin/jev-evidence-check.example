#!/usr/bin/env python3

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path


SUPPORT_THRESHOLD = 0.70
SECRET_RE = re.compile(
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----|"
    r"\bAuthorization\s*:\s*(?:Bearer|Basic)\s+[^\s'\"]+|"
    r"\bBearer\s+[A-Za-z0-9._~+/=-]{12,}|"
    r"\bAKIA[0-9A-Z]{16}\b|"
    r"\bglpat-[A-Za-z0-9_-]{12,}\b|"
    r"\b(?:sk|xai)-[A-Za-z0-9_-]{16,}\b|"
    r"\bAIza[0-9A-Za-z_-]{20,}\b|"
    r"\bgh[opusr]_[A-Za-z0-9]{20,}\b|"
    r"\b(?:api[_-]?key|token|password|secret)\s*[:=]\s*[^\s'\"]{8,}",
    re.IGNORECASE,
)


def stop(message, exit_code=2):
    print(message, file=sys.stderr)
    raise SystemExit(exit_code)


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Check whether observed evidence directly supports an exact causal or remediation claim."
    )
    parser.add_argument("--evidence-file", required=True)
    parser.add_argument("--claim-file", required=True)
    return parser.parse_args(argv)


def read_utf8(raw, option):
    path = Path(raw).expanduser()
    if not path.is_file():
        stop(f"{option} requires an existing regular file.")
    try:
        value = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        stop(f"{option} must be UTF-8.")
    if not value.strip():
        stop(f"{option} must not be empty.")
    return value


def unavailable(reason):
    print(f"Jev evidence check unavailable: {reason}", file=sys.stderr)
    print(json.dumps({"decision": "unavailable"}, sort_keys=True))


def ensure_api_key():
    key = os.environ.get("TYPESAFE_API_KEY", "").strip()
    if key:
        return True
    launcher = os.environ.get("KEYCHAIN_ENV_EXEC", "/Users/kei/.local/bin/keychain-env-exec")
    try:
        completed = subprocess.run(
            [
                launcher,
                "TYPESAFE_API_KEY",
                "JEV_PERMISSION_REVIEW_API_KEY",
                "--",
                sys.executable,
                str(Path(__file__).resolve()),
                *sys.argv[1:],
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as error:
        unavailable(type(error).__name__)
        return None
    try:
        child_output = json.loads(completed.stdout)
    except json.JSONDecodeError:
        child_output = None
    if (
        completed.returncode not in (0, 1)
        or not isinstance(child_output, dict)
        or child_output.get("decision") not in {"supported", "unsupported", "unavailable"}
    ):
        unavailable("credential unavailable")
        return None
    sys.stdout.write(completed.stdout)
    sys.stderr.write(completed.stderr)
    raise SystemExit(completed.returncode)


def request_check(evidence, claim):
    payload = {
        "schemaVersion": 1,
        "evidence": evidence,
        "claim": claim,
        "contract": {
            "id": "ai-dev-harness.evidence-check",
            "version": "1",
            "axes": [
                {
                    "id": "claim_supported",
                    "instructions": (
                        "Does the observed evidence directly support the proposed claim at the claim's exact "
                        "specificity? Mere consistency is insufficient. Reject a root-cause, remedy, ownership, "
                        "policy, configuration, plan-adequacy, or system-wide claim when plausible alternatives "
                        "remain. An explicit error can support the immediate stopping layer without supporting a "
                        "deeper cause or prescribed remedy. Judge only the supplied evidence and claim."
                    ),
                }
            ],
        },
        "model": "jev-latest",
    }
    evaluator = os.environ.get(
        "JEV_KIT_EVIDENCE_CLI",
        "/Users/kei/.local/bin/jev-kit-evidence-check",
    )
    try:
        completed = subprocess.run(
            [evaluator],
            input=json.dumps(payload, ensure_ascii=False),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        output = json.loads(completed.stdout)
        scores = output.get("scores") if isinstance(output, dict) else None
        score = scores.get("claim_supported") if isinstance(scores, dict) else None
        if completed.returncode != 0 or not isinstance(output, dict) or output.get("status") != "evaluated":
            raise ValueError("evaluator unavailable")
        if isinstance(score, bool) or not isinstance(score, (int, float)):
            raise ValueError("invalid claim_supported score")
        return float(score)
    except (OSError, TypeError, ValueError, json.JSONDecodeError) as error:
        unavailable(type(error).__name__)
        return None


def main():
    args = parse_args(sys.argv[1:])
    evidence = read_utf8(args.evidence_file, "--evidence-file")
    claim = read_utf8(args.claim_file, "--claim-file")
    if SECRET_RE.search(f"{evidence}\n{claim}"):
        stop("Evidence check input contains a credential or secret candidate; nothing was sent.")
    if ensure_api_key() is None:
        return
    score = request_check(evidence, claim)
    if score is None:
        return
    decision = "supported" if score >= SUPPORT_THRESHOLD else "unsupported"
    print(json.dumps({"claim_supported": score, "decision": decision}, sort_keys=True))
    if decision == "unsupported":
        raise SystemExit(1)


if __name__ == "__main__":
    main()
