#!/usr/bin/env python3

import argparse
import json
import math
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path
from urllib.parse import urlsplit


DEFAULT_API_URL = "https://api.typesafe.ai/v1/systemone"
VIOLATION_REVIEW_THRESHOLD = 0.70
CHECK_ROUTE_THRESHOLD = 0.70
SECRET_RE = re.compile(
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----|"
    r"\bAuthorization\s*:\s*(?:Bearer|Basic)\s+[^\s'\"]+|"
    r"\bBearer\s+[A-Za-z0-9._~+/=-]{12,}|"
    r"\bAKIA[0-9A-Z]{16}\b|"
    r"\bglpat-[A-Za-z0-9_-]{12,}\b|"
    r"\b(?:sk|xai)-[A-Za-z0-9_-]{16,}\b|"
    r"\bAIza[0-9A-Za-z_-]{20,}\b|"
    r"\bgh[opusr]_[A-Za-z0-9]{20,}\b",
    re.IGNORECASE,
)


def stop(message, exit_code=2):
    print(message, file=sys.stderr)
    raise SystemExit(exit_code)


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Review an artifact against explicit requirements with Jev."
    )
    parser.add_argument("--requirements-file", required=True)
    parser.add_argument("--candidate-file", required=True)
    parser.add_argument("--baseline-file")
    parser.add_argument(
        "--route-checks",
        action="store_true",
        help="Return evidence-based deterministic and Jev-routed verification checks.",
    )
    return parser.parse_args(argv)


def resolve_input_file(raw, option):
    path = Path(raw).expanduser()
    if not path.is_file():
        stop(f"{option} requires an existing regular file.")
    return path.resolve()


def read_utf8(path, option):
    try:
        value = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        stop(f"{option} must be UTF-8.")
    if not value.strip():
        stop(f"{option} must not be empty.")
    return value


def load_api_key(fallback=None):
    key = os.environ.get("TYPESAFE_API_KEY", "").strip()
    if key:
        return key
    launcher = os.environ.get("KEYCHAIN_ENV_EXEC", "/Users/kei/.local/bin/keychain-env-exec")
    try:
        completed = subprocess.run(
            [
                launcher,
                "TYPESAFE_API_KEY",
                "JEV_PERMISSION_REVIEW_API_KEY",
                "--",
                sys.executable,
                str(Path(__file__).resolve()),
                *sys.argv[1:],
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as error:
        unavailable(type(error).__name__, fallback)
        return None
    try:
        child_output = json.loads(completed.stdout)
    except json.JSONDecodeError:
        child_output = None
    if (
        completed.returncode not in (0, 1)
        or not isinstance(child_output, dict)
        or child_output.get("decision") not in {"pass", "review", "unavailable"}
    ):
        unavailable("credential unavailable", fallback)
        return None
    sys.stdout.write(completed.stdout)
    sys.stderr.write(completed.stderr)
    raise SystemExit(completed.returncode)


def api_url():
    configured = os.environ.get("JEV_ARTIFACT_REVIEW_API_URL", "").strip()
    if not configured:
        return DEFAULT_API_URL
    parsed = urlsplit(configured)
    if parsed.scheme == "http" and parsed.hostname in {"127.0.0.1", "::1", "localhost"}:
        return configured
    return DEFAULT_API_URL


def probability(payload, name):
    answers = payload.get("answers") if isinstance(payload, dict) else None
    answer = answers.get(name) if isinstance(answers, dict) else None
    value = answer.get("noul") if isinstance(answer, dict) else None
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise TypeError(name)
    result = float(value)
    if not math.isfinite(result) or not 0.0 <= result <= 1.0:
        raise ValueError(name)
    return result


def unavailable(reason, extra=None):
    print(f"Jev artifact review unavailable: {reason}", file=sys.stderr)
    output = {"decision": "unavailable"}
    if isinstance(extra, dict):
        output.update(extra)
    print(json.dumps(output, sort_keys=True))


def artifact_features(value):
    lowered = value.lower()
    patterns = {
        "iframe": r"<iframe\b",
        "script": r"<script\b",
        "media": r"<(?:video|audio)\b",
        "controls": r"<(?:button|select|input|textarea|form)\b",
    }
    return sorted(name for name, pattern in patterns.items() if re.search(pattern, lowered))


def runtime_fragments(value):
    patterns = (
        r"<script\b[^>]*>.*?</script>",
        r"<iframe\b[^>]*>",
        r"<(?:video|audio|button|select|input|textarea|form)\b[^>]*>",
    )
    fragments = []
    for pattern in patterns:
        fragments.extend(re.findall(pattern, value, flags=re.IGNORECASE | re.DOTALL))
    return [re.sub(r"\s+", " ", fragment).strip() for fragment in fragments]


def inherited_route(candidate, baseline):
    baseline_features = artifact_features(baseline or "")
    candidate_features = artifact_features(candidate)
    inherited = set(baseline_features or candidate_features)
    runtime = bool(inherited & {"iframe", "script", "media", "controls"})
    interactive = bool(inherited & {"iframe", "media", "controls"})
    runtime_changed = baseline is not None and runtime_fragments(baseline) != runtime_fragments(candidate)
    return {
        "inherited_runtime_features": sorted(inherited),
        "runtime_contract_changed": runtime_changed,
        "required_checks": {
            "fact_and_comparison_check": False,
            "changed_region_visual": False,
            "full_page_visual": False,
            "browser_smoke": runtime,
            "interaction_journey": runtime_changed or (baseline is None and interactive),
        },
    }


def routed_checks(base, scores):
    checks = dict(base["required_checks"])
    checks["fact_and_comparison_check"] = scores.get("meaning_changed", 0.0) >= CHECK_ROUTE_THRESHOLD
    checks["changed_region_visual"] = scores.get("layout_changed", 0.0) >= CHECK_ROUTE_THRESHOLD
    checks["full_page_visual"] = scores.get("whole_artifact_changed", 0.0) >= CHECK_ROUTE_THRESHOLD
    interaction_changed = scores.get("interaction_changed", 0.0) >= CHECK_ROUTE_THRESHOLD
    checks["browser_smoke"] = checks["browser_smoke"] or interaction_changed
    checks["interaction_journey"] = checks["interaction_journey"] or interaction_changed
    return {
        "inherited_runtime_features": base["inherited_runtime_features"],
        "runtime_contract_changed": base["runtime_contract_changed"],
        "route_scores": scores,
        "required_checks": checks,
    }


def request_review(key, requirements, candidate, baseline, candidate_name, route_checks):
    state = {
        "requirements": requirements,
        "candidate_name": candidate_name,
        "candidate": candidate,
    }
    if baseline is not None:
        state["baseline"] = baseline
    questions = {
        "material_violation": {
            "type": "noul",
            "instructions": (
                "Does the candidate artifact materially violate the explicit requirements or preservation "
                "constraints? When a baseline is present, judge the described change from baseline to "
                "candidate. Count unrequested scope, structure or theme changes; deleted required content; "
                "misleading parallel presentation of metrics with different definitions or comparison "
                "conditions; unrequested defensive, process or excuse copy; and factual misrepresentation "
                "of roles or flows as violations. Do not flag requested limitations, requested structural "
                "changes, ordinary implementation details, or visual geometry that cannot be established "
                "from the text. Judge only the supplied artifact and requirements; do not invent unseen defects."
            ),
        }
    }
    if route_checks:
        questions.update({
            "meaning_changed": {
                "type": "noul",
                "instructions": (
                    "Does the candidate change factual claims, metric definitions, comparison conditions, roles, "
                    "flows or conclusions beyond a local wording-only edit?"
                ),
            },
            "layout_changed": {
                "type": "noul",
                "instructions": (
                    "Does the candidate change layout, SVG geometry, CSS, visual grouping or information placement "
                    "so that the changed region should be rendered and inspected?"
                ),
            },
            "interaction_changed": {
                "type": "noul",
                "instructions": (
                    "Does the candidate change scripts, embeds, media, links, controls, file versus HTTP loading, "
                    "or another runtime interaction path that should be exercised in a browser?"
                ),
            },
            "whole_artifact_changed": {
                "type": "noul",
                "instructions": (
                    "Does the candidate change cross-section structure, hierarchy, theme or composition broadly "
                    "enough that the complete artifact should be rendered instead of only the changed region?"
                ),
            },
        })
    body = json.dumps(
        {
            "model": "jev-latest",
            "state": state,
            "questions": questions,
        },
        ensure_ascii=False,
    ).encode("utf-8")
    request = urllib.request.Request(
        api_url(),
        data=body,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            payload = json.load(response)
        material = probability(payload, "material_violation")
        scores = {}
        if route_checks:
            for name in (
                "meaning_changed",
                "layout_changed",
                "interaction_changed",
                "whole_artifact_changed",
            ):
                try:
                    scores[name] = probability(payload, name)
                except (TypeError, ValueError):
                    continue
        return material, scores, None
    except (
        OSError,
        TypeError,
        ValueError,
        urllib.error.HTTPError,
        urllib.error.URLError,
    ) as error:
        return None, {}, type(error).__name__


def main():
    args = parse_args(sys.argv[1:])
    requirements_file = resolve_input_file(args.requirements_file, "--requirements-file")
    candidate_file = resolve_input_file(args.candidate_file, "--candidate-file")
    baseline_file = (
        resolve_input_file(args.baseline_file, "--baseline-file")
        if args.baseline_file
        else None
    )
    requirements = read_utf8(requirements_file, "--requirements-file")
    candidate = read_utf8(candidate_file, "--candidate-file")
    baseline = read_utf8(baseline_file, "--baseline-file") if baseline_file else None
    values = [requirements, candidate]
    if baseline is not None:
        values.append(baseline)
    if SECRET_RE.search("\n".join(values)):
        stop("Artifact review input contains a credential or secret candidate; nothing was sent.")

    base_route = inherited_route(candidate, baseline) if args.route_checks else None
    key = load_api_key(base_route)
    if key is None:
        return
    score, route_scores, unavailable_reason = request_review(
        key,
        requirements,
        candidate,
        baseline,
        candidate_file.name,
        args.route_checks,
    )
    if score is None:
        unavailable(unavailable_reason or "invalid response", base_route)
        return
    decision = "review" if score >= VIOLATION_REVIEW_THRESHOLD else "pass"
    output = {
        "decision": decision,
        "material_violation": score,
    }
    if args.route_checks:
        output.update(routed_checks(base_route, route_scores))
    print(json.dumps(output, sort_keys=True))
    if decision == "review":
        raise SystemExit(1)


if __name__ == "__main__":
    main()
