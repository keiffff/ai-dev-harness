#!/usr/bin/env python3

import argparse
import json
import math
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path
from urllib.parse import urlsplit


DEFAULT_API_URL = "https://api.typesafe.ai/v1/systemone"
VIOLATION_REVIEW_THRESHOLD = 0.70
SECRET_RE = re.compile(
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----|"
    r"\bAuthorization\s*:\s*(?:Bearer|Basic)\s+[^\s'\"]+|"
    r"\bBearer\s+[A-Za-z0-9._~+/=-]{12,}|"
    r"\bAKIA[0-9A-Z]{16}\b|"
    r"\bglpat-[A-Za-z0-9_-]{12,}\b|"
    r"\b(?:sk|xai)-[A-Za-z0-9_-]{16,}\b|"
    r"\bAIza[0-9A-Za-z_-]{20,}\b|"
    r"\bgh[opusr]_[A-Za-z0-9]{20,}\b",
    re.IGNORECASE,
)


def stop(message, exit_code=2):
    print(message, file=sys.stderr)
    raise SystemExit(exit_code)


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Review an artifact against explicit requirements with Jev."
    )
    parser.add_argument("--requirements-file", required=True)
    parser.add_argument("--candidate-file", required=True)
    parser.add_argument("--baseline-file")
    return parser.parse_args(argv)


def resolve_input_file(raw, option):
    path = Path(raw).expanduser()
    if not path.is_file():
        stop(f"{option} requires an existing regular file.")
    return path.resolve()


def read_utf8(path, option):
    try:
        value = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        stop(f"{option} must be UTF-8.")
    if not value.strip():
        stop(f"{option} must not be empty.")
    return value


def load_api_key():
    key = os.environ.get("TYPESAFE_API_KEY", "").strip()
    if key:
        return key
    launcher = os.environ.get("KEYCHAIN_ENV_EXEC", "/Users/kei/.local/bin/keychain-env-exec")
    try:
        completed = subprocess.run(
            [
                launcher,
                "TYPESAFE_API_KEY",
                "JEV_PERMISSION_REVIEW_API_KEY",
                "--",
                sys.executable,
                str(Path(__file__).resolve()),
                *sys.argv[1:],
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as error:
        unavailable(type(error).__name__)
        return None
    try:
        child_output = json.loads(completed.stdout)
    except json.JSONDecodeError:
        child_output = None
    if (
        completed.returncode not in (0, 1)
        or not isinstance(child_output, dict)
        or child_output.get("decision") not in {"pass", "review", "unavailable"}
    ):
        unavailable("credential unavailable")
        return None
    sys.stdout.write(completed.stdout)
    sys.stderr.write(completed.stderr)
    raise SystemExit(completed.returncode)


def api_url():
    configured = os.environ.get("JEV_ARTIFACT_REVIEW_API_URL", "").strip()
    if not configured:
        return DEFAULT_API_URL
    parsed = urlsplit(configured)
    if parsed.scheme == "http" and parsed.hostname in {"127.0.0.1", "::1", "localhost"}:
        return configured
    return DEFAULT_API_URL


def probability(payload):
    answers = payload.get("answers") if isinstance(payload, dict) else None
    answer = answers.get("material_violation") if isinstance(answers, dict) else None
    value = answer.get("noul") if isinstance(answer, dict) else None
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise TypeError("material_violation")
    result = float(value)
    if not math.isfinite(result) or not 0.0 <= result <= 1.0:
        raise ValueError("material_violation")
    return result


def unavailable(reason):
    print(f"Jev artifact review unavailable: {reason}", file=sys.stderr)
    print(json.dumps({"decision": "unavailable"}, sort_keys=True))


def request_review(key, requirements, candidate, baseline, candidate_name):
    state = {
        "requirements": requirements,
        "candidate_name": candidate_name,
        "candidate": candidate,
    }
    if baseline is not None:
        state["baseline"] = baseline
    body = json.dumps(
        {
            "model": "jev-latest",
            "state": state,
            "questions": {
                "material_violation": {
                    "type": "noul",
                    "instructions": (
                        "Does the candidate artifact materially violate the explicit requirements or preservation "
                        "constraints? When a baseline is present, judge the described change from baseline to "
                        "candidate. Count unrequested scope, structure or theme changes; deleted required content; "
                        "misleading parallel presentation of metrics with different definitions or comparison "
                        "conditions; unrequested defensive, process or excuse copy; and factual misrepresentation "
                        "of roles or flows as violations. Do not flag requested limitations, requested structural "
                        "changes, ordinary implementation details, or visual geometry that cannot be established "
                        "from the text. Judge only the supplied artifact and requirements; do not invent unseen defects."
                    ),
                }
            },
        },
        ensure_ascii=False,
    ).encode("utf-8")
    request = urllib.request.Request(
        api_url(),
        data=body,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            payload = json.load(response)
        return probability(payload)
    except (
        OSError,
        TypeError,
        ValueError,
        urllib.error.HTTPError,
        urllib.error.URLError,
    ) as error:
        unavailable(type(error).__name__)
        return None


def main():
    args = parse_args(sys.argv[1:])
    requirements_file = resolve_input_file(args.requirements_file, "--requirements-file")
    candidate_file = resolve_input_file(args.candidate_file, "--candidate-file")
    baseline_file = (
        resolve_input_file(args.baseline_file, "--baseline-file")
        if args.baseline_file
        else None
    )
    requirements = read_utf8(requirements_file, "--requirements-file")
    candidate = read_utf8(candidate_file, "--candidate-file")
    baseline = read_utf8(baseline_file, "--baseline-file") if baseline_file else None
    values = [requirements, candidate]
    if baseline is not None:
        values.append(baseline)
    if SECRET_RE.search("\n".join(values)):
        stop("Artifact review input contains a credential or secret candidate; nothing was sent.")

    key = load_api_key()
    if key is None:
        return
    score = request_review(
        key,
        requirements,
        candidate,
        baseline,
        candidate_file.name,
    )
    if score is None:
        return
    decision = "review" if score >= VIOLATION_REVIEW_THRESHOLD else "pass"
    print(json.dumps({
        "decision": decision,
        "material_violation": score,
    }, sort_keys=True))
    if decision == "review":
        raise SystemExit(1)


if __name__ == "__main__":
    main()
